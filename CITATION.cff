    given-names: "Esteban Andrés"
    affiliation: "Universidad Nacional de Colombia, Sede de La Paz"
repository-code: "https://github.com/EARodriguezM/e6r-1"
version: "v0.0.5"
date-released: "2026-10-31"
keywords:
  - "robotic arm"
  - "6-DOF"
  - "kinematics"
  - "MATLAB"
  - "Simulink"
  - "ESP32"
  - "3D printing"
  - "URDF"
